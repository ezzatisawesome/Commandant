[Unit]
# Commandant console — the web app served on :80 so http://commandant.local/ opens
# straight in any browser with no port to type. Talks to gs over WS (host-relative,
# so it reaches whichever host served the page = the hub).
Description=Commandant console (Next.js production server on :80)
After=network-online.target
Wants=network-online.target

# Restart=always means always. Without this it does not: systemd's default
# start limit is 5 starts per 10 s, and RestartSec=2 hits exactly that, so a
# service that crash-loops for ten seconds at boot enters `failed` and STAYS
# there until somebody ssh's in. On a hub whose premise is "turn the plane on,
# turn the hub on, open the page", the likeliest cause of such a loop is
# transient -- the radio enumerating a moment late, a stale instance still
# holding the port -- and permanently failing on it is the worst answer
# available. Zero disables the limit, so it retries until it works.
StartLimitIntervalSec=0

[Service]
Type=simple
# next workspace binary is hoisted to the monorepo root node_modules by npm
# workspaces. Build once at provision time (`npm run build --workspace console`).
WorkingDirectory=/opt/commandant/packages/console
ExecStart=/opt/commandant/node_modules/.bin/next start -H 0.0.0.0 -p 80
Restart=always
RestartSec=2
User=commandant
Group=commandant
# Bind privileged port 80 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
