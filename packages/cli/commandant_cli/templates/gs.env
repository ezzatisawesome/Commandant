# Commandant gs daemon environment — installed to /etc/commandant/gs.env.
# Consumed by deploy/systemd/gs.service.

# The plane's telemetry radio as a pymavlink endpoint. `auto` probes USB
# serial, a Raspberry Pi's UART (/dev/serial0), then UDP :14550 and TCP :5760,
# and re-probes whenever the link drops. Pin it when more than one is present:
#   serial:/dev/ttyUSB0:57600   — USB telemetry radio (SiK-style)
#   serial:/dev/serial0:57600   — radio wired to a Pi's GPIO UART
#   udpin:0.0.0.0:14550         — bench/SITL over the network
GS_MAVLINK=auto

# WebSocket port the console connects to (host-relative on the client side).
GS_WS_PORT=8790

# Where replayable .tlog flight logs are written. systemd's StateDirectory
# creates /var/lib/commandant for the commandant user, so this needs no setup.
# gs caps the directory and prunes oldest-first, because a full SD card is a hub
# that cannot write the log explaining why it stopped. Pass --no-log to disable.
GS_LOG_DIR=/var/lib/commandant/logs

# The secret the console asks for before it will take command (arm, change
# mode, upload a mission). Watching telemetry never needs it. `commandant
# install` generates one the first time it writes this file and prints it once;
# read it again with `sudo grep GS_COMMAND_TOKEN /etc/commandant/gs.env`.
# Empty means anyone on the hub's WiFi can arm the aircraft, and gs says so at
# every start.
GS_COMMAND_TOKEN=

# PX4 event metadata for the FLASHED firmware. PX4 reports why it refused a
# mission or a mode through its events protocol; without this file the console
# sees only "not available". Copy build/px4_fmu-v6x_default/events/all_events.json
# from the mojave-px4 tree that produced the image, and point at it here.
#GS_EVENTS_META=/etc/commandant/all_events.json

# --- optional: publish this flight to the public viewer -----------------------
# OUTBOUND ONLY. The hub dials out and never reads a reply, so enabling this
# creates no inbound path to the aircraft: command authority stays on the hub's
# own WiFi. Leave both unset to keep the hub entirely offline.
#
# gs reads these directly (they are the env form of --relay / --relay-token),
# so no change to gs.service is needed.
#COMMANDANT_RELAY=wss://commandant-relay.fly.dev/publish
#COMMANDANT_RELAY_TOKEN=
