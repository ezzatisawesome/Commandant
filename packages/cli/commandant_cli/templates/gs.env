# Commandant gs daemon environment — copy to /etc/commandant/gs.env on the Pi.
# Consumed by deploy/systemd/gs.service.

# The plane's telemetry radio as a pymavlink endpoint. Common cases:
#   serial:/dev/serial0:57600   — Pi UART / SiK-style radio (typical field setup)
#   serial:/dev/ttyUSB0:57600   — USB telemetry radio
#   udpin:0.0.0.0:14550         — bench/SITL over the network
GS_MAVLINK=serial:/dev/serial0:57600

# WebSocket port the console connects to (host-relative on the client side).
GS_WS_PORT=8790

# Where replayable .tlog flight logs are written. systemd's StateDirectory
# creates /var/lib/commandant for the commandant user, so this needs no setup.
# gs caps the directory and prunes oldest-first, because a full SD card is a hub
# that cannot write the log explaining why it stopped. Pass --no-log to disable.
GS_LOG_DIR=/var/lib/commandant/logs

# --- optional: publish this flight to the public viewer -----------------------
# OUTBOUND ONLY. The hub dials out and never reads a reply, so enabling this
# creates no inbound path to the aircraft: command authority stays on the hub's
# own WiFi. Leave both unset to keep the hub entirely offline.
#
# gs reads these directly (they are the env form of --relay / --relay-token),
# so no change to gs.service is needed.
#COMMANDANT_RELAY=wss://commandant-relay.fly.dev/publish
#COMMANDANT_RELAY_TOKEN=
